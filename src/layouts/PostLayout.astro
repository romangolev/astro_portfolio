---
import MainLayout from './MainLayout.astro';
import Giscus from '../components/Giscus.astro';
import { formatDate } from '../utils/formatDate.js';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  readingTime?: number;
  tags?: string[];
  heroImage?: string;
  nextPost?: { title: string; slug: string };
}

const {
  title = 'Untitled Post',
  description,
  date,
  readingTime,
  tags = [],
  heroImage,
  nextPost,
} = Astro.props;
---

<MainLayout title={title} description={description} ogType="article">
  <article class="post glass-panel glass-panel--reading">
    <header>
      <a class="back-link" href="/posts">← All posts</a>
      <h1>{title}</h1>
      {description && <p class="description">{description}</p>}
      {(date || readingTime) && (
        <div class="meta">
          {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
          {readingTime && <span>{readingTime} min read</span>}
        </div>
      )}
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>

    {heroImage && (
      <img class="hero-image" src={heroImage} alt={title} loading="lazy" decoding="async" />
    )}

    <div class="content prose">
      <slot />
    </div>

    <nav class="more-writing" aria-labelledby="more-writing-label">
      <h2 class="more-writing-label" id="more-writing-label">More writing</h2>
      {nextPost && (
        <a class="more-writing-next" href={`/posts/${nextPost.slug}`}>
          Next: {nextPost.title} →
        </a>
      )}
    </nav>

    <Giscus />
  </article>
</MainLayout>

<style>
  .post {
    width: min(40rem, 100% - var(--space-4) - var(--space-4));
    margin: var(--space-6) auto;
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  header {
    margin-bottom: var(--space-6);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: .25rem;
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  h1 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-h1);
  }

  .description {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero-image {
    width: 100%;
    margin-bottom: var(--space-5);
    border-radius: var(--radius-md);
  }

  /* One rule only: the Giscus block below brings its own separator. */
  .more-writing {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    max-width: var(--measure);
    margin-top: var(--space-6);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .more-writing-label {
    flex: 0 0 auto;
    margin: 0;
    white-space: nowrap;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--color-text-secondary);
  }

  .more-writing-next {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    min-height: 44px;
    padding-block: .25rem;
    font-size: var(--text-sm);
    font-weight: 600;
    overflow-wrap: anywhere;
    text-align: left;
    color: var(--color-text);
  }

  .more-writing-next:hover,
  .more-writing-next:focus-visible {
    color: var(--color-accent);
  }

  /* Wide enough for label and link on one baseline row. */
  @media (min-width: 48rem) {
    .more-writing {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-4);
    }

    .more-writing-next {
      text-align: left;
    }
  }
</style>
