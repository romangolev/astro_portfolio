---
import MainLayout from './MainLayout.astro';
import Giscus from '../components/Giscus.astro';
import { formatDate } from '../utils/formatDate.js';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  technologies?: string[];
  github?: string;
  repo?: string;
  demo?: string;
  image?: string;
}

const {
  title,
  description,
  date,
  technologies = [],
  github,
  repo,
  demo,
  image,
} = Astro.props;

const repoUrl = github ?? (repo ? `https://github.com/${repo}` : undefined);
---

<MainLayout title={title} description={description} ogType="article">
  <article class="project glass-panel glass-panel--reading">
    <header class="project-header">
      <a class="back-link" href="/projects">← All projects</a>
      <h1>{title}</h1>
      {description && <p class="description">{description}</p>}

      <div class="meta">
        <div class="meta-details">
          {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
          {technologies.length > 0 && (
            <div class="tags">
              {technologies.map((tech) => <span class="tag">{tech}</span>)}
            </div>
          )}
        </div>
      </div>

      {(repoUrl || demo) && (
        <div class="actions">
          {repoUrl && (
            <a
              class="btn btn--ghost"
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${title} on GitHub (opens in a new tab)`}
            >
              GitHub
            </a>
          )}
          {demo && (
            <a class="btn btn--primary" href={demo} target="_blank" rel="noopener noreferrer">
              Demo
            </a>
          )}
        </div>
      )}
    </header>

    {image && (
      <img class="hero-image" src={image} alt={title} loading="lazy" decoding="async" />
    )}

    <div class="content prose">
      <slot />
    </div>

    <Giscus />
  </article>
</MainLayout>

<style>
  .project {
    width: min(40rem, 100% - var(--space-4) - var(--space-4));
    margin: var(--space-6) auto;
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  .project-header {
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: .25rem;
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  h1 {
    margin: 0;
    font-size: var(--text-h1);
  }

  .description {
    margin: var(--space-3) 0 0;
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
  }

  .meta-details {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Actions sit at the end of the intro, above the header rule. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--space-2);
    width: 100%;
    margin-top: var(--space-4);
  }

  .hero-image {
    width: 100%;
    margin-bottom: var(--space-5);
    border-radius: var(--radius-md);
  }
</style>
