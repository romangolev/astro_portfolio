---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import { formatDate } from '../utils/formatDate.js';
import { getInitials } from '../utils/initials.js';

const allProjects = await getCollection('projects');
const bySlug = new Map(allProjects.map((project) => [project.slug, project]));
const newest = [...allProjects].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const repoUrl = (project) =>
  project.data.github ??
  (project.data.repo ? `https://github.com/${project.data.repo}` : undefined);

// One featured project keeps the column from pairing a screenshot with an
// initials tile. The two notable siblings read as a compact text line below.
const featured = bySlug.get('pyarchitect') ?? newest[0];
const curatedAlso = ['navistools', 'pyrevit']
  .map((slug) => bySlug.get(slug))
  .filter((project) => project !== undefined && project.slug !== featured?.slug);
// Only fall back to the two newest others if the curated set is incomplete.
const also =
  bySlug.has('pyarchitect') && bySlug.has('navistools')
    ? curatedAlso
    : newest.filter((project) => project.slug !== featured?.slug).slice(0, 2);
const featuredRepo = featured ? repoUrl(featured) : undefined;

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<MainLayout title="Home">
  <section class="hero">
    <div class="hero-intro">
      <h1 class="hero-name">Roman Golev</h1>
      <p class="hero-role">Software Engineer</p>
      <p class="hero-location">Barcelona, Catalonia, Spain</p>
      <p class="hero-summary">
        A Software Engineer with a 5+ years experience designing, developing and maintaining scalable, effective and secure solutions across FinTech, AEC and Learning/Education domains. I am proactive specialist with an end-to-end ownership mindset have a proactive approach. Actual builder of ideas, being enthusiastic about seeing the product actually strive. Open-Source geek and a road bike rider.
      </p>
      <div class="hero-actions">
        <a class="btn btn--primary" href="mailto:rv.golev@gmail.com">Email me</a>
        <a class="btn btn--ghost" href="/projects">View projects</a>
      </div>
    </div>

    <section class="selected" aria-labelledby="selected-work">
      <h2 class="section-label" id="selected-work">Selected work</h2>
      {featured && (
        <div class="selected-feature">
          {featured.data.image ? (
            <img
              class="selected-cover"
              src={featured.data.image}
              alt={`${featured.data.title} screenshot`}
              width="140"
              height="105"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="selected-cover selected-monogram" aria-hidden="true">
              {getInitials(featured.data.title)}
            </div>
          )}
          <div class="selected-body">
            <h3 class="selected-title">
              <a href={`/projects/${featured.slug}`}>{featured.data.title}</a>
            </h3>
            <p class="selected-description">{featured.data.description}</p>
            {featuredRepo && (
              <a
                class="selected-repo"
                href={featuredRepo}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${featured.data.title} on GitHub (opens in a new tab)`}
              >
                GitHub ↗
              </a>
            )}
            {featured.data.technologies.length > 0 && (
              <ul class="tag-list">
                {featured.data.technologies.map((tech) => (
                  <li><span class="tag">{tech}</span></li>
                ))}
              </ul>
            )}
          </div>
        </div>
      )}
      {also.length > 0 && (
        <p class="selected-also">
          <span class="selected-also-label">Also:</span>{' '}
          {also.map((project, index) => (
            <Fragment>
              {index > 0 && <span aria-hidden="true"> · </span>}
              <a href={`/projects/${project.slug}`}>{project.data.title}</a>
            </Fragment>
          ))}
        </p>
      )}
      <a class="more-link" href="/projects">All projects →</a>
    </section>
  </section>

  <section class="writing">
    <h2 class="section-label">Latest writing</h2>
    <ul class="writing-list">
      {posts.map((post) => (
        <li>
          <a class="writing-title" href={`/posts/${post.slug}`}>{post.data.title}</a>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </li>
      ))}
    </ul>
    <a class="more-link" href="/posts">All posts →</a>
  </section>
</MainLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--space-7);
    align-items: start;
    max-width: var(--container);
    margin: clamp(3rem, 7vh, 5rem) auto;
    padding-inline: var(--space-4);
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }

  .hero-name {
    margin: 0 0 var(--space-2);
    font-size: var(--text-display);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero-role {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-accent);
  }

  .hero-location {
    margin: 0 0 var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .hero-summary {
    max-width: var(--measure);
    margin: 0 0 var(--space-5);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .section-label {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }

  .selected-feature {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .selected-cover {
    width: 140px;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    object-position: left center;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .selected-monogram {
    display: grid;
    place-items: center;
    background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 24%, transparent) 1px,
      transparent 1px
    );
    background-size: 9px 9px;
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .selected-title {
    margin: 0;
    font-size: var(--text-h3);
  }

  /* Titles read as text; the accent belongs to the actions around them. */
  .selected-title a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .selected-title a:hover,
  .selected-title a:focus-visible {
    color: var(--color-accent);
  }

  .selected-description {
    margin: var(--space-1) 0 var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .selected-repo {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding-block: .25rem;
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .selected-also {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .selected-also-label {
    font-weight: 600;
    color: var(--color-text);
  }

  .selected-also a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding-block: .25rem;
    color: var(--color-accent);
  }

  .selected-also a:hover,
  .selected-also a:focus-visible {
    color: var(--color-text);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: .25rem;
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .writing {
    width: calc(100% - 2 * var(--space-4));
    max-width: calc(var(--container) - 2 * var(--space-4));
    margin-inline: auto;
    padding: var(--space-6) 0 0;
    border-top: 1px solid var(--color-border);
  }

  .writing-list {
    max-width: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .writing-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .writing-list li:last-child {
    border-bottom: none;
  }

  .writing-title {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--color-text);
  }

  .writing-title:hover,
  .writing-title:focus-visible {
    color: var(--color-accent);
  }

  .writing-list time {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    white-space: nowrap;
    color: var(--color-text-secondary);
  }

  /* Three newest posts share one row from tablet up, so the landing page reads
     as a single screen rather than a list. */
  @media (min-width: 40rem) {
    .writing-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .writing-list li {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding: 0 0 var(--space-3);
    }

    .writing-list time {
      margin-top: auto;
    }
  }

  /* Phone landing: keep the identity, selected work and latest writing inside
     one screen by dropping the secondary metadata from the work teaser. */
  @media (max-width: 47.999rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      margin-block: var(--space-2);
    }

    .hero-name {
      font-size: clamp(2.1rem, 9vw, 2.75rem);
    }

    .hero-role {
      margin-bottom: var(--space-1);
    }

    .hero-location {
      margin-bottom: var(--space-3);
    }

    .hero-summary {
      font-size: .9rem;
      line-height: 1.5;
      margin-bottom: var(--space-3);
    }

    .selected-feature {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .selected-cover,
    .selected-monogram,
    .selected-description,
    .selected-body .tag-list,
    .selected-also {
      display: none;
    }

    .selected-repo {
      min-height: 28px;
      margin-bottom: 0;
    }

    .more-link {
      min-height: 28px;
      margin-top: var(--space-1);
    }

    .writing {
      padding-top: var(--space-3);
    }

    .writing-list li {
      padding: var(--space-1) 0;
    }

    /* A one-line teaser keeps the three newest posts inside the phone screen;
       the full titles remain on /posts. */
    .writing-title {
      width: 100%;
      min-width: 0;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .section-label {
      margin-bottom: var(--space-2);
    }
  }

  @media (max-width: 24rem) {
    .hero-summary {
      font-size: .85rem;
      line-height: 1.45;
    }

    .selected-repo {
      display: none;
    }
  }

  /* Short phones: drop the writing teaser first, then the work teaser on the
     smallest screens, so the profile still owns one screen. */
  @media (max-width: 47.999rem) and (max-height: 45rem) {
    .writing {
      display: none;
    }
  }

  @media (max-width: 22rem) and (max-height: 40rem) {
    .selected {
      display: none;
    }
  }

  /* Shorter desktop windows drop the writing teaser before the hero and work
     do; the Posts link in the header still reaches the archive. */
  @media (min-width: 64rem) and (max-width: 68rem) and (max-height: 45rem) {
    .writing {
      display: none;
    }
  }

  @media (min-width: 64rem) and (max-height: 42rem) {
    .writing {
      display: none;
    }
  }

  /* Very short desktop windows keep only the profile and actions. */
  @media (min-width: 64rem) and (max-height: 32rem) {
    .hero {
      grid-template-columns: 1fr;
      margin-block: 0;
    }

    .selected,
    .hero-location {
      display: none;
    }

    .hero-role {
      margin-bottom: 0;
    }

    .hero-summary {
      font-size: .9rem;
      line-height: 1.5;
      margin-bottom: var(--space-2);
    }
  }

  /* Landscape phones: the profile and its two actions are the home screen. */
  @media (max-height: 30rem) {
    .hero {
      grid-template-columns: 1fr;
      margin-block: var(--space-2);
    }

    .selected,
    .writing,
    .hero-location,
    .hero-summary {
      display: none;
    }

    .hero-role {
      margin-bottom: var(--space-3);
    }
  }

  /* Tablet: two-column hero, featured project stacked below its cover. */
  @media (min-width: 48rem) and (max-width: 64rem) {
    .selected-feature {
      grid-template-columns: 1fr;
      align-items: start;
      gap: var(--space-3);
    }

    .selected-cover,
    .selected-monogram {
      width: 100%;
      max-width: 240px;
    }
  }

  /* Desktop: cover beside the text. */
  @media (min-width: 64.0625rem) {
    .selected-feature {
      grid-template-columns: 180px minmax(0, 1fr);
    }

    .selected-cover {
      width: 180px;
    }
  }

  /* Short viewports: tighten the vertical rhythm so the home stays on screen. */
  @media (min-width: 48rem) and (max-height: 64rem) {
    .hero {
      gap: var(--space-5);
      margin-block: var(--space-3);
    }

    .hero-name {
      font-size: clamp(2.5rem, 7vh, 3.5rem);
    }

    .hero-role {
      margin-bottom: var(--space-1);
    }

    .hero-location {
      margin-bottom: var(--space-4);
    }

    .hero-summary {
      font-size: .95rem;
      line-height: 1.6;
      margin-bottom: var(--space-4);
    }

    .writing {
      padding-top: var(--space-3);
    }

    .writing-list {
      gap: var(--space-5);
    }

    .writing-list li {
      padding-bottom: var(--space-2);
    }

    .more-link {
      min-height: 28px;
      margin-top: var(--space-2);
    }
  }
</style>
