---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout title="About">
  <Header slot="header" />

  <section class="about">
    <h1>About Me</h1>
    <div class="content glass-panel">
      <p>A Software Engineer with a 5+ years experience designing, developing and maintaining scalable, effective and secure solutions across FinTech, AEC and Learning/Education domains. I am proactive specialist with an end-to-end ownership mindset have a proactive approach. Actual builder of ideas, being enthusiastic about seeing the product actually strive. Open-Source geek and a road bike rider.</p>

      <h2>Technical Expertise</h2>
      <div class="skills-grid">
        <div class="skill-category glass-panel glass-panel--card">
          <h3>Product Engineering</h3>
          <p>React, TypeScript, Node.js, REST APIs, and PostgreSQL for web and backend systems.</p>
        </div>
        <div class="skill-category glass-panel glass-panel--card">
          <h3>.NET and Desktop</h3>
          <p>C#, .NET, WPF, MVVM, and WebView2 for desktop applications and integrations.</p>
        </div>
        <div class="skill-category glass-panel glass-panel--card">
          <h3>AEC Software</h3>
          <p>Revit API, Navisworks API, Dynamo, and BIM automation tools.</p>
        </div>
        <div class="skill-category glass-panel glass-panel--card">
          <h3>Delivery</h3>
          <p>Docker, CI/CD, GitHub Actions, Azure, AWS, and build automation.</p>
        </div>
        <div class="skill-category glass-panel glass-panel--card">
          <h3>Data</h3>
          <p>PostgreSQL, MySQL, SQL, and data integration for product systems.</p>
        </div>
        <div class="skill-category glass-panel glass-panel--card">
          <h3>Quality</h3>
          <p>Unit and integration testing with NUnit, Jest, and pytest.</p>
        </div>
      </div>

      <h2>Open Source</h2>
      <ul>
        <li>Contributions to pyRevit and related AEC developer tooling</li>
        <li>Python, C#, and Revit automation projects</li>
      </ul>

      <p style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--color-border);">
        Interested in collaborating? Check out my projects and posts, or reach out through my social links.
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>

<style>
  /* Matches .posts and .projects so page titles line up across the site. */
  .about {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  /* The page title sits on the background; only the body copy gets a panel. */
  .about h1 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .content {
    line-height: 1.7;
    color: var(--color-text);
    padding: 2rem;
  }

  .content > *:first-child {
    margin-top: 0;
  }

  .content p {
    margin: 1rem 0;
  }

  .content h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-text);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .content h3 {
    font-size: 1.1rem;
    margin: 0.5rem 0;
    color: var(--color-accent);
  }

  .content ul {
    list-style-position: inside;
    margin: 1rem 0;
  }

  .content li {
    margin: 0.5rem 0;
    color: var(--color-text-secondary);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }

  .timeline li {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
    position: relative;
  }

  .timeline li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
    font-size: 1.2rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .skill-category {
    padding: 1.25rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .skill-category:hover {
    transform: translateY(-4px);
    box-shadow: var(--glass-inset), var(--glass-shadow-hover);
    border-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-category:hover {
      transform: none;
    }
  }

  .skill-category h3 {
    margin-top: 0;
    color: var(--color-accent);
    font-size: 1rem;
    font-weight: 600;
  }

  .skill-category p {
    margin: 0.75rem 0 0 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>
