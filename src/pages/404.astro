---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Page not found" noindex>
  <div class="page not-found">
    <div class="glass-panel glass-panel--card panel">
      <p class="not-found-code">404</p>
      <h1>Page not found</h1>
      <p>That page doesn't exist or has moved. Try one of these instead:</p>
      <div class="actions">
        <a class="btn btn--primary" href="/">Back home</a>
        <a class="btn btn--ghost" href="/projects">Projects</a>
        <a class="btn btn--ghost" href="/posts">Posts</a>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100dvh - 13.5rem);
  }

  .panel {
    position: relative;
    max-width: 38rem;
    padding: clamp(2rem, 6vw, 3.5rem);
    padding-left: var(--space-6);
    text-align: left;
  }

  /* Inset rule instead of border-left: a border follows the rounded corners
     and detaches at the ends, while this stays anchored to the panel body. */
  .panel::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1rem;
    bottom: 1rem;
    width: 3px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .panel .not-found-code {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .panel h1 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-h1);
  }

  .panel p {
    margin: 0 0 var(--space-5);
    color: var(--color-text-secondary);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--space-3);
  }

  @media (max-height: 38rem) {
    .not-found {
      min-height: 0;
      padding-block: var(--space-3);
    }

    .panel {
      padding-block: var(--space-5);
    }
  }

  @media (max-width: 30rem) {
    .actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Primary action spans the full width; the two secondary actions pair up. */
    .actions .btn:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
