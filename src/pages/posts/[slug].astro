---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

// Generate static paths for all posts
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  // Newest first, so the entry after a post is the next older one.
  const ordered = [...posts].sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );

  return posts.map(post => {
    const index = ordered.findIndex((entry) => entry.slug === post.slug);
    const older = ordered[index + 1];

    return {
      params: { slug: post.slug },
      props: {
        post,
        nextPost: older
          ? { title: older.data.title, slug: older.slug }
          : undefined,
      },
    };
  });
}

const { post, nextPost } = Astro.props;
const { Content } = await post.render();

const data = post.data;
const words = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.round(words / 200));
---

<PostLayout
  title={data.title}
  description={data.description}
  date={data.date}
  readingTime={readingTime}
  tags={data.tags}
  heroImage={data.image}
  nextPost={nextPost}
>
  <Content />
</PostLayout>
