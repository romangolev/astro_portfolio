---
import BaseCard from './BaseCard.astro';

const { project } = Astro.props;

// Projects may link a full URL (`github`) or the shorter `owner/repo` form.
const repoUrl = project.github ?? (project.repo ? `https://github.com/${project.repo}` : undefined);
---

<BaseCard
  title={project.title}
  description={project.description}
  url={`/projects/${project.slug}`}
  tags={project.technologies}
  repo={repoUrl}
/>
